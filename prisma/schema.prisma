generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Analysis {
  id                String    @id
  ownerWorkosUserId String?
  status            String    @default("pending") // "pending" | "running" | "complete" | "failed"
  source            String // "url" | "pdf" | "txt" | "paste" | "live"
  sourceRef         String? // URL or filename
  title             String?
  text              String // full normalized text
  language          String? // "pt" | "en" | ...
  provider          String // "anthropic" | "openai"
  model             String
  score             Int       @default(0) // 0..100 fallacy intensity
  summary           String? // short verdict
  blocks            String    @default("[]") // JSON structural paragraphs with section/reference metadata
  sentences         String    @default("[]") // JSON array of {id,start,end,text}
  findings          String    @default("[]") // JSON array of findings
  transcript        String? // raw transcript accumulated during a live session
  liveContext       String? // JSON LiveContext recap for live sessions
  contextRevision   Int       @default(0) // owner mutations increment; analysis writes use optimistic concurrency
  audioDurationMs   Int? // total audio duration captured (live mode)
  errorMessage      String?
  createdAt         DateTime  @default(now())
  finishedAt        DateTime?
  reviewedAt        DateTime? // null = not yet human-reviewed; viewer shows a warning banner until set

  knowledgeEntityMentions   KnowledgeEntityMention[]
  knowledgeRelationMentions KnowledgeRelationMention[]
  contextSessionEvents      ContextSessionEvent[]

  @@index([ownerWorkosUserId, createdAt])
}

// Private, append-only replay log for Context sessions. Payloads may contain
// transcript-derived data and must only be read through the owning Analysis.
model ContextSessionEvent {
  id                String   @id @default(cuid())
  analysisId        String
  ownerWorkosUserId String?
  kind              String
  elapsedMs         Int
  sentenceIds       String   @default("[]")
  payload           String   @default("{}")
  createdAt         DateTime @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId, elapsedMs, createdAt])
  @@index([ownerWorkosUserId, createdAt])
}

model AppSetting {
  key       String   @id // dotted key, e.g. "rate.factcheck.capacity"
  value     String // JSON-encoded value (scalar or object)
  updatedAt DateTime @updatedAt
}

model Invitation {
  id                     String    @id @default(cuid())
  inviterWorkosUserId    String
  inviterEmail           String
  inviterName            String?
  inviteeEmail           String    @unique
  message                String?
  locale                 String    @default("en")
  tokenHash              String    @unique
  rewardCredits          Int
  deliveryStatus         String    @default("queued") // queued | sent | failed
  resendEmailId          String?
  lastDeliveryError      String?
  sentAt                 DateTime?
  expiresAt              DateTime
  acceptedAt             DateTime?
  acceptedByWorkosUserId String?   @unique
  rewardTransactionId    String?   @unique
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([inviterWorkosUserId, createdAt])
  @@index([deliveryStatus, createdAt])
  @@index([expiresAt, acceptedAt])
}

model ApiKey {
  id                String    @id // nanoid(12) — public identifier, safe to log
  keyHash           String    @unique // sha256("jiddu-api:" + secret) — the secret itself is never stored
  prefix            String // first chars of the secret, shown in admin to identify the key
  label             String // human label set at creation
  ownerWorkosUserId String?
  ownerEmail        String?
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime?
  revokedAt         DateTime? // null = active
  rateCapacity      Int? // per-key burst override (null = use global settings)
  ratePerHour       Int? // per-key sustained-rate override (null = use global settings)

  @@index([keyHash])
  @@index([revokedAt])
  @@index([ownerWorkosUserId])
  @@index([ownerEmail])
}

model ProviderCredential {
  id              String   @id @default(cuid())
  workosUserId    String
  provider        String
  encryptedSecret String
  connectedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([workosUserId, provider])
  @@index([workosUserId])
}

model PlatformAccessGrant {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model JidduCreditAccount {
  workosUserId String   @id
  email        String
  balance      Int      @default(0)
  reserved     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transactions JidduCreditTransaction[]
  reservations JidduCreditReservation[]
  purchases    StripeCreditPurchase[]

  @@index([email])
  @@index([updatedAt])
}

model JidduCreditTransaction {
  id                 String   @id @default(cuid())
  workosUserId       String
  amount             Int
  balanceAfter       Int
  kind               String // grant | adjustment | purchase | usage | included_usage | invite_bonus
  feature            String?
  resourceId         String?
  rateVersion        String?
  note               String?
  metadata           String   @default("{}")
  actorWorkosUserId  String?
  promptTokens       Int?
  completionTokens   Int?
  totalTokens        Int?
  reasoningTokens    Int?
  cachedTokens       Int?
  providerCostMicros Int?
  billedCostMicros   Int?
  marginMultiplier   Float?
  usdPerCredit       Float?
  createdAt          DateTime @default(now())

  account JidduCreditAccount @relation(fields: [workosUserId], references: [workosUserId], onDelete: Cascade)

  @@index([workosUserId, createdAt])
  @@index([kind, createdAt])
  @@index([resourceId])
}

model JidduCreditReservation {
  id           String    @id @default(cuid())
  workosUserId String
  amount       Int
  actualAmount Int?
  status       String    @default("pending") // pending | settled | released | expired
  feature      String
  resourceId   String?
  rateVersion  String
  metadata     String    @default("{}")
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  settledAt    DateTime?

  account JidduCreditAccount @relation(fields: [workosUserId], references: [workosUserId], onDelete: Cascade)

  @@index([workosUserId, status])
  @@index([expiresAt, status])
  @@index([resourceId])
}

model JidduCreditPackage {
  id            String   @id @default(cuid())
  name          String
  descriptionEn String?
  descriptionPt String?
  descriptionEs String?
  credits       Int
  priceUsdCents Int?
  priceBrlCents Int?
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active, sortOrder])
}

model StripeCreditPurchase {
  id                      String   @id @default(cuid())
  stripeCheckoutSessionId String   @unique
  stripePaymentIntentId   String?  @unique
  stripeCustomerId        String?
  stripePriceId           String
  workosUserId            String
  email                   String
  packageId               String?
  packageName             String
  credits                 Int
  amountCents             Int
  currency                String
  livemode                Boolean
  fulfilledAt             DateTime @default(now())
  createdAt               DateTime @default(now())

  account JidduCreditAccount @relation(fields: [workosUserId], references: [workosUserId], onDelete: Cascade)

  @@index([workosUserId, createdAt])
  @@index([fulfilledAt])
}

model SlopCheck {
  id                String    @id
  ownerWorkosUserId String?
  status            String    @default("pending") // "pending" | "running" | "complete" | "failed"
  source            String // "url" | "pdf" | "txt" | "paste"
  sourceRef         String?
  title             String?
  text              String
  language          String?
  provider          String
  model             String
  score             Int       @default(0) // 0..100 slop intensity
  summary           String?
  blocks            String    @default("[]") // JSON structural paragraphs with section/reference metadata
  sentences         String    @default("[]") // JSON array of {id,start,end,text}
  findings          String    @default("[]") // JSON array of SlopFinding
  errorMessage      String?
  createdAt         DateTime  @default(now())
  finishedAt        DateTime?
  reviewedAt        DateTime?

  @@index([ownerWorkosUserId, createdAt])
}

model Neutrality {
  id                String    @id
  ownerWorkosUserId String?
  status            String    @default("pending") // "pending" | "running" | "complete" | "failed"
  source            String // "url" | "pdf" | "txt" | "paste"
  sourceRef         String?
  title             String?
  text              String
  language          String?
  provider          String
  model             String
  textType          String? // informational | opinion | political_speech | advocacy | analysis | marketing | social_media
  verdict           String    @default("pending") // neutral | partisan_lean | explicitly_partisan | manipulation | pending
  confidence        Float     @default(0)
  rationale         String?
  blocks            String    @default("[]") // JSON structural paragraphs with section/reference metadata
  sentences         String    @default("[]") // JSON array of {id,start,end,text}
  findings          String    @default("[]") // JSON array of NeutralityFinding
  errorMessage      String?
  createdAt         DateTime  @default(now())
  finishedAt        DateTime?
  reviewedAt        DateTime?

  @@index([ownerWorkosUserId, createdAt])
}

model Explanation {
  id                String    @id
  ownerWorkosUserId String?
  status            String    @default("pending") // "pending" | "running" | "complete" | "failed"
  source            String // "url" | "pdf" | "txt" | "paste"
  sourceRef         String?
  title             String?
  text              String
  language          String?
  provider          String
  model             String
  level             String    @default("undergrad") // eli5 | high_school | undergrad | expert
  overview          String? // plain-language abstract of the whole paper at the chosen level
  paperMap          String? // JSON PaperMap: document type, question, approach, evidence, answer and stated limitation
  blocks            String    @default("[]") // JSON array of {id,start,end,text} paragraph blocks
  findings          String    @default("[]") // JSON array of ExplainFinding {blockIds, role, explanation}
  errorMessage      String?
  createdAt         DateTime  @default(now())
  finishedAt        DateTime?
  reviewedAt        DateTime?

  @@index([ownerWorkosUserId, createdAt])
}

model PaperReview {
  id                String    @id
  ownerWorkosUserId String?
  status            String    @default("pending") // pending | running | complete | failed
  stage             String    @default("ingest") // ingest | ledger | research | specs | verification | synthesis | self_critique | source_validation | quality_audit | complete
  source            String    @default("pdf")
  sourceRef         String?
  title             String?
  author            String?
  venueTarget       String
  venueProfile      String? // versioned resolved venue rubric, criteria, and official sources
  reviewDate        String // YYYY-MM-DD, kept verbatim for deterministic export
  language          String?
  provider          String
  model             String
  reviewDepth       String    @default("standard") // standard | deep
  parser            String? // liteparse | pdfjs
  text              String
  pages             String    @default("[]") // page-numbered LiteParse/PDF.js output
  complexity        String    @default("[]") // per-page OCR/layout signals
  ledger            String? // private structured claim/evidence ledger
  research          String? // external published-literature memo + citations
  specsReviews      String? // five private independent SPECS specialist artifacts
  computationAudit  String? // deterministic checks proposed by specialists
  initialReview     String? // private first synthesis, retained for audit/debugging
  sourceAudit       String? // URL reachability, title consistency, publication type
  qualityAudit      String? // independent critic flags and finding decisions
  retentionAudit    String? // deterministic specialist-finding retention gate
  telemetry         String    @default("[]") // append-only stage/model-call timing events
  review            String? // final self-critiqued PaperReviewResult JSON
  markdown          String? // deterministic export generated from final JSON
  errorMessage      String?
  createdAt         DateTime  @default(now())
  finishedAt        DateTime?
  reviewedAt        DateTime?

  @@index([ownerWorkosUserId, createdAt])
}

model VerdictFeedback {
  id              String    @id @default(cuid())
  factCheckId     String // links back to /f/[id]
  claimId         String // claim id inside that FactCheck row
  statement       String // snapshot of the claim statement at feedback time
  verdictSnapshot String // JSON of the Verdict the user was complaining about
  userReason      String? // free-text from user (optional)
  status          String    @default("open") // "open" | "resolved" | "ignored"
  ip              String? // abuse / dedup signal, never shown to users
  resolutionNote  String? // admin's note on resolve/ignore
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  @@index([status, createdAt])
  @@index([factCheckId])
}

model ClaimVerdict {
  hash        String   @id // sha256(normalize(statement) + ':' + lang)
  statement   String // original — kept for debugging / inspection
  language    String // "en" | "pt" | "es"
  type        String // claim type at cache time (numeric | date | quote | causal | categorical)
  verdict     String // "supported" | "contradicted" | "mixed" | "unverified"
  confidence  Float
  rationale   String
  sources     String   @default("[]") // JSON array of { url, title?, snippet? }
  verifyModel String // upstream model that produced the verdict
  cachedAt    DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

model FactCheck {
  id                String    @id
  ownerWorkosUserId String?
  status            String    @default("pending") // "pending" | "running" | "complete" | "failed"
  source            String // "url" | "pdf" | "txt" | "paste"
  sourceRef         String? // URL or filename
  title             String?
  text              String // full normalized text
  language          String? // "pt" | "en" | "es"
  provider          String // "openai" (mapped from MODEL_CATALOG family)
  model             String // catalog id, e.g. "gpt-5.6-luna"
  blocks            String    @default("[]") // JSON structural paragraphs with section/reference metadata
  sentences         String    @default("[]") // JSON array of {id,start,end,text}
  claims            String    @default("[]") // JSON array of {id, sentenceIds, statement, type, rationale}
  verdicts          String    @default("[]") // JSON array of {claimId, verdict, confidence, rationale, sources, model}
  refreshCounts     String    @default("{}") // JSON map { claimId: count } — each verify call bumps the per-claim counter
  verifyStatus      String    @default("none") // "none" | "running" | "complete" | "failed"
  verifyModel       String? // model id used for verification, e.g. "sonar-reasoning"
  verifyStartedAt   DateTime?
  verifyFinishedAt  DateTime?
  errorMessage      String?
  createdAt         DateTime  @default(now())
  finishedAt        DateTime?
  reviewedAt        DateTime? // null = not yet human-reviewed; viewer shows a warning banner until set

  @@index([ownerWorkosUserId, createdAt])
}

// Reusable entity handles become public knowledge only after attributed
// enrichment. Full private transcript data stays in the *Mention models.
model KnowledgeEntity {
  id                 String    @id @default(cuid())
  canonicalKey       String    @unique
  canonicalName      String
  type               String // person | institution | organization | country | event
  description        String?
  imageUrl           String?
  wikipediaUrl       String?
  wikidataId         String?   @unique
  profileLanguage    String?
  profileStatus      String    @default("pending") // pending | ready | not_found | failed
  profileFetchedAt   DateTime?
  profileExpiresAt   DateTime?
  publiclyEnrichedAt DateTime? // null means this is only a private-session candidate handle
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  aliases                  KnowledgeEntityAlias[]
  snapshots                KnowledgeEntitySnapshot[]
  sources                  KnowledgeEntitySource[]
  outgoingRelations        KnowledgeRelation[]        @relation("KnowledgeRelationSourceEntity")
  incomingRelations        KnowledgeRelation[]        @relation("KnowledgeRelationTargetEntity")
  mentions                 KnowledgeEntityMention[]
  relationMentionsAsSource KnowledgeRelationMention[] @relation("KnowledgeMentionSourceEntity")
  relationMentionsAsTarget KnowledgeRelationMention[] @relation("KnowledgeMentionTargetEntity")
  enrichmentJobs           KnowledgeEnrichmentJob[]

  @@index([type, canonicalName])
  @@index([profileExpiresAt])
  @@index([publiclyEnrichedAt])
}

model KnowledgeEntityAlias {
  id             String   @id @default(cuid())
  entityId       String
  displayName    String
  normalizedName String
  language       String   @default("und")
  createdAt      DateTime @default(now())

  entity KnowledgeEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, normalizedName, language])
  @@index([normalizedName, language])
}

model KnowledgeSource {
  id          String    @id @default(cuid())
  url         String    @unique
  title       String
  publisher   String
  sourceType  String // wikipedia | official | news | reference
  publishedAt DateTime?
  retrievedAt DateTime  @default(now())
  metadata    String    @default("{}")

  entitySnapshots KnowledgeEntitySnapshot[]
  entityLinks     KnowledgeEntitySource[]
  relationLinks   KnowledgeRelationSource[]

  @@index([sourceType, retrievedAt])
  @@index([publishedAt])
}

model KnowledgeEntitySnapshot {
  id        String   @id @default(cuid())
  entityId  String
  sourceId  String
  language  String
  summary   String
  payload   String   @default("{}")
  fetchedAt DateTime @default(now())
  expiresAt DateTime

  entity KnowledgeEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([entityId, sourceId, language])
  @@index([entityId, expiresAt])
}

model KnowledgeEntitySource {
  id           String   @id @default(cuid())
  entityId     String
  sourceId     String
  relevance    Float    @default(0)
  summary      String?
  discoveredAt DateTime @default(now())
  expiresAt    DateTime

  entity KnowledgeEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([entityId, sourceId])
  @@index([entityId, expiresAt])
}

model KnowledgeRelation {
  id              String   @id @default(cuid())
  sourceEntityId  String
  targetEntityId  String
  normalizedLabel String
  label           String
  description     String?
  status          String   @default("related_coverage") // related_coverage | official | disputed
  confidence      Float    @default(0)
  firstObservedAt DateTime @default(now())
  lastObservedAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sourceEntity KnowledgeEntity            @relation("KnowledgeRelationSourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity KnowledgeEntity            @relation("KnowledgeRelationTargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)
  sources      KnowledgeRelationSource[]
  mentions     KnowledgeRelationMention[]
  jobs         KnowledgeEnrichmentJob[]

  @@unique([sourceEntityId, targetEntityId, normalizedLabel])
  @@index([sourceEntityId, lastObservedAt])
  @@index([targetEntityId, lastObservedAt])
}

model KnowledgeRelationSource {
  id           String   @id @default(cuid())
  relationId   String
  sourceId     String
  relevance    Float    @default(0)
  summary      String?
  discoveredAt DateTime @default(now())
  expiresAt    DateTime

  relation KnowledgeRelation @relation(fields: [relationId], references: [id], onDelete: Cascade)
  source   KnowledgeSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([relationId, sourceId])
  @@index([relationId, expiresAt])
}

// These rows are private session indexes. They must never be exposed through
// the public/global knowledge cache without an ownership check.
model KnowledgeEntityMention {
  id                String   @id @default(cuid())
  analysisId        String
  ownerWorkosUserId String
  entityId          String
  localEntityId     String
  name              String
  kind              String
  description       String
  aliases           String   @default("[]")
  sentenceIds       String   @default("[]")
  confidence        Float
  importance        Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  analysis Analysis        @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  entity   KnowledgeEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([analysisId, entityId])
  @@index([analysisId, localEntityId])
  @@index([ownerWorkosUserId, createdAt])
}

model KnowledgeRelationMention {
  id                  String   @id @default(cuid())
  analysisId          String
  ownerWorkosUserId   String
  relationId          String?
  sourceEntityId      String
  targetEntityId      String
  sourceLocalEntityId String
  targetLocalEntityId String
  localRelationId     String
  label               String
  description         String
  normalizedLabel     String
  sentenceIds         String   @default("[]")
  confidence          Float
  importance          Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  analysis     Analysis           @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  relation     KnowledgeRelation? @relation(fields: [relationId], references: [id], onDelete: SetNull)
  sourceEntity KnowledgeEntity    @relation("KnowledgeMentionSourceEntity", fields: [sourceEntityId], references: [id], onDelete: Cascade)
  targetEntity KnowledgeEntity    @relation("KnowledgeMentionTargetEntity", fields: [targetEntityId], references: [id], onDelete: Cascade)

  @@unique([analysisId, sourceEntityId, targetEntityId, normalizedLabel])
  @@index([analysisId, localRelationId])
  @@index([ownerWorkosUserId, createdAt])
}

model KnowledgeEnrichmentJob {
  id          String    @id @default(cuid())
  targetKey   String
  kind        String // entity_profile | entity_news | relation_news
  status      String    @default("pending") // pending | running | complete | failed
  entityId    String?
  relationId  String?
  attempts    Int       @default(0)
  lastError   String?
  runAfter    DateTime  @default(now())
  lockedAt    DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  entity   KnowledgeEntity?   @relation(fields: [entityId], references: [id], onDelete: SetNull)
  relation KnowledgeRelation? @relation(fields: [relationId], references: [id], onDelete: SetNull)

  @@unique([targetKey, kind])
  @@index([status, runAfter])
}
