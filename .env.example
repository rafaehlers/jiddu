DATABASE_URL="file:./dev.db"

# Canonical public origin. Use http://localhost:3000 locally and
# https://jiddu.app in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe Checkout. These values are server-only; never prefix them with
# NEXT_PUBLIC_. The webhook secret belongs to the specific endpoint/mode.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PLUS=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_STUDIO=""

# WorkOS AuthKit. Configure the same callback and sign-in endpoints in the
# WorkOS dashboard and allow this app origin under Sessions -> CORS for the
# profile/security widgets. WORKOS_COOKIE_PASSWORD must be at least 32 characters.
WORKOS_API_KEY=""
WORKOS_CLIENT_ID=""
WORKOS_COOKIE_PASSWORD=""
NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/callback"
WORKOS_AUTHKIT_DOMAIN="https://your-project.authkit.app"

# OAuth audience/resource for the hosted MCP server. Register this exact URL
# as a Resource Indicator under WorkOS Connect → Configuration.
MCP_RESOURCE_URL="http://localhost:3000/api/mcp"

# OpenRouter — server-managed provider access for web, REST, hosted MCP, evals
# and the admin balance. Included accounts and Jiddu-credit users share it.
OPENROUTER_API_KEY=""

# Optional: identify this deployment to OpenRouter analytics dashboard.
OPENROUTER_REFERER="https://jiddu.app"

# Jiddu-credit settlement. The rate card reserves an estimated maximum before
# work starts; completed OpenRouter calls settle from the returned real cost.
# Defaults: 1 Jiddu credit = US$0.01 and a 1.5x billing multiplier.
JIDDU_CREDIT_USD_VALUE="0.01"
JIDDU_CREDIT_MARGIN_MULTIPLIER="1.5"
JIDDU_LIVE_TRANSCRIPTION_CREDITS="20"

# Optional internal routing for adversarial review depth=deep.
PAPER_REVIEW_DEEP_MODEL="gpt-5.5"
PAPER_REVIEW_CRITIC_MODEL="claude-opus-4.8"

# Comma-separated verified WorkOS emails allowed to open /admin. Admin
# accounts receive included use of the deployment's OpenRouter key.
ADMIN_EMAILS=""

# OpenAI — direct API key for the /live realtime transcription mode
# (gpt-live-transcribe). Get a key at https://platform.openai.com/api-keys.
# Only required if you want to use /live; the standard /api/analyze flow
# uses OPENROUTER_API_KEY above.
OPENAI_API_KEY=""

# GPT Live Transcribe latency/accuracy balance:
# minimal | low | medium | high | xhigh. Defaults to medium.
OPENAI_LIVE_TRANSCRIBE_DELAY="medium"
