DATABASE_URL="file:./dev.db"

# OpenRouter — unified gateway for all LLMs. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# Optional: identify this deployment to OpenRouter analytics dashboard.
OPENROUTER_REFERER="https://jiddu.app"

# Password for the /admin area. Leave empty to disable the admin login.
ADMIN_PASSWORD=""

# OpenAI — direct API key for the /live realtime transcription mode
# (gpt-realtime-whisper). Get a key at https://platform.openai.com/api-keys.
# Only required if you want to use /live; the standard /api/analyze flow
# uses OPENROUTER_API_KEY above.
OPENAI_API_KEY=""
