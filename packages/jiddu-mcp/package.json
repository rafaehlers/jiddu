{
  "name": "jiddu-mcp",
  "version": "0.1.0",
  "description": "MCP server for Jiddu — detect logical fallacies, fact-check claims, assess neutrality, and explain papers in any text.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Rafael M. Ehlers",
  "homepage": "https://jiddu.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaehlers/jiddu.git",
    "directory": "packages/jiddu-mcp"
  },
  "keywords": ["mcp", "model-context-protocol", "fact-check", "fallacy", "claude", "agents"],
  "bin": {
    "jiddu-mcp": "dist/index.js"
